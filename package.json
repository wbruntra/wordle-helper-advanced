{
  "name": "wordle-helper",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "api": "portless wordle-api bun --watch bin/www",
    "client": "cd client-v2 && bun run dev",
    "dev": "bun run --parallel api client",
    "migrate": "bun --bun run knex migrate:latest --env development",
    "build:client": "cd client-v2 && bun run build",
    "deploy": "ansible-playbook -i ansible/inventory.yml ansible/deploy.yml -e deployment=production",
    "deploy:nginx": "ansible-playbook -i ansible/inventory.yml ansible/deploy-nginx.yml -e deployment=production",
    "typecheck": "bun check && bun check -p shared && bun check -p client-v2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@wordle/shared": "workspace:*",
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "express": "^5.1.0",
    "inquirer": "^12.10.0",
    "knex": "^3.1.0",
    "knex-bun-sqlite": "^1.4.0",
    "morgan": "^1.10.1",
    "openai": "^4.104.0",
    "randomstring": "^1.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.9.1",
    "domhandler": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "shared",
    "client-v2"
  ]
}
